{
  "permissions": {
    "allow": [
      "Read", "Write", "Glob", "Grep", "Agent", "ToolSearch",
      "WebFetch", "WebSearch",
      "TaskOutput",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)",
      "Bash(grep:*)", "Bash(rg:*)", "Bash(wc:*)", "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)",
      "Bash(git status:*)", "Bash(git branch:*)",
      "Bash(python3:*)", "Bash(sqlite3:*)",
      "Bash(mkdir:*)",
      "mcp__perf-tools__backlog_status",
      "mcp__perf-tools__propose_targets"
    ],
    "deny": [
      "Edit",
      "Bash(dotnet:*)",
      "Bash(git checkout:*)", "Bash(git commit:*)", "Bash(git push:*)",
      "Bash(git merge:*)", "Bash(git rebase:*)", "Bash(git reset:*)",
      "Bash(cp:*)", "Bash(mv:*)", "Bash(rm:*)", "Bash(chmod:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["./loop-state", "/tmp/perf-agents"],
      "denyWrite": ["/etc", "/usr/bin", "/usr/local/bin"],
      "denyRead": ["/home/*/.ssh", "/home/*/.aws", "/home/*/.gnupg", "/home/*/.claude"]
    },
    "network": {
      "allowedDomains": [
        "github.com", "api.github.com",
        "nuget.org", "api.nuget.org",
        "api.anthropic.com",
        "docs.rs", "doc.rust-lang.org"
      ]
    }
  },
  "mcpServers": {
    "perf-tools": {
      "command": "python3",
      "args": ["__MCP_SERVER_PATH__", "--role", "worker-research"],
      "env": {
        "PERF_DB_PATH": "__PERF_DB_PATH__",
        "PERF_REPO_ROOT": "__PERF_REPO_ROOT__"
      }
    }
  }
}
